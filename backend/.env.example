DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/demoiw
APP_ENV=development
LOG_LEVEL=INFO

# OpenRouter — copy this file to backend/.env and add YOUR OWN key.
# Get a free key at https://openrouter.ai/keys (no credit needed for :free models).
# Each developer uses their own key — never share or commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Free NVIDIA Nemotron tier ($0 in/out). Drop to :super or :nano for more speed.
MODEL_DATA_ENRICHMENT=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_COMMUNICATIONS=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_NL_QUERY=nvidia/nemotron-3-ultra-550b-a55b:free